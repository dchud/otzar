# Django

# required when DEBUG is false (the app refuses to start without it);
# generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# set to false in production
DEBUG=true

ALLOWED_HOSTS=localhost,127.0.0.1

# set to the deployed site URL(s) when hosted, e.g. https://example.org
# leave empty for local dev
CSRF_TRUSTED_ORIGINS=

# root for persistent data (db, media, cache live under this)
# point at persistent storage when hosted; locally: defaults to project root
# e.g. database at DATA_DIR/db.sqlite3, images at DATA_DIR/media/
DATA_DIR=

# IANA time zone for the site: where a day begins and ends (the daily
# OCR cap resets at its midnight) and how times are shown. Storage is
# UTC regardless. Defaults to UTC; e.g. America/New_York
TIME_ZONE=

# address of the reverse proxy in front of gunicorn; gunicorn trusts
# X-Forwarded-* headers only from it. Behind a proxy on the Docker host,
# the Docker bridge address. Unused by runserver.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Claude Vision OCR

# required for title page scanning
ANTHROPIC_API_KEY=

# Rough cost per scan at list prices: Haiku 4.5 ~$0.004, Sonnet 5 ~$0.011,
# Opus 5 ~$0.018. Sonnet reads Hebrew decorative type far more accurately
# than Haiku (11/12 vs 5/12 in testing).
CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_MODEL=claude-haiku-4-5
# CLAUDE_MODEL=claude-opus-5

# Ceiling on OCR calls per day, across every user, past which Run OCR
# is refused until local midnight. Guards against a retry loop (a bad
# photo, a stuck phone) spending without bound; defaults to 500 if unset.
# OCR_DAILY_CALL_CAP=500

# Media on S3. With AWS_S3_MEDIA_BUCKET set, uploaded images are stored
# in that private bucket and served through presigned URLs; unset, they
# go to DATA_DIR/media. The credentials are read by boto3.
# AWS_S3_MEDIA_BUCKET=
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# optional: another S3-compatible service, e.g. a local stand-in
# AWS_S3_ENDPOINT_URL=http://localhost:9000

# SRU catalog endpoints (defaults are the public endpoints; leave empty to use defaults)
# SRU_NLI_URL=https://nli.alma.exlibrisgroup.com/view/sru/972NNL_INST
# SRU_LC_URL=http://lx2.loc.gov:210/LCDB
# SRU_DNB_URL=https://services.dnb.de/sru/dnb
# SRU_VIAF_URL=https://viaf.org/viaf/search

# seconds between requests to external catalogs
SRU_REQUEST_DELAY=3

# Open Library Covers API (optional override)
# COVER_API_URL=https://covers.openlibrary.org/b

# Site settings

# prefix for generated record identifiers
RECORD_ID_PREFIX=otzar-

# if set, every page, the login pages included, requires this password;
# with DEBUG=false, leaving it empty makes manage.py check warn
SITE_PASSWORD=
