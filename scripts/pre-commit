#!/usr/bin/env bash
set -e

echo "Running pre-commit checks..."

if ! uv run ruff format --check . 2>/dev/null; then
    echo ""
    echo "Format check failed. Run: uv run ruff format ."
    exit 1
fi

if ! uv run ruff check . 2>/dev/null; then
    echo ""
    echo "Lint check failed. Run: uv run ruff check --fix ."
    exit 1
fi

if ! uv run python scripts/lint_process_labels.py; then
    echo ""
    echo "Process labels belong in commit messages, PR bodies and bead"
    echo "descriptions, not in code, tests or user-facing docs."
    exit 1
fi

echo "All checks passed."
